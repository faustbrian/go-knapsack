        ],
        "responsibility": "Provide deterministic, bounded offline orthogonal packing, exact objectives, extension constraints, canonical plans, and independent verification.",
        "non_goals": [
          "Implement classical value-maximization knapsack selection or silently omit requested items.",
          "Provide continuous physics, irregular geometry, hazardous-goods, robotic-motion, pallet, or vehicle-axle simulation.",
          "Own monetary arithmetic, persistence, orchestration, application policy, or process-global state."
        ],
        "public_package_identifier": "knapsack",
        "primary_entry_packages": [
          "github.com/faustbrian/go-knapsack"
        ],
        "package_selection": {
          "github.com/faustbrian/go-knapsack": "Use for immutable packing requests, exact lattice normalization, bounded resource policy, and canonical plan values.",
          "github.com/faustbrian/go-knapsack/constraint": "Use to define trusted synchronous placement constraints over immutable bounded views.",
          "github.com/faustbrian/go-knapsack/encoding": "Use for strict bounded canonical JSON request and plan interchange.",
          "github.com/faustbrian/go-knapsack/geometry": "Use for checked integer cuboids, physical-axis orientations, and half-open spatial predicates.",
          "github.com/faustbrian/go-knapsack/knapsacktest": "Use in tests for canonical plan comparison and independent verification assertions.",
          "github.com/faustbrian/go-knapsack/objective": "Use to define exact deterministic plan objectives and lexicographic criteria.",
          "github.com/faustbrian/go-knapsack/solver": "Use for bounded deterministic heuristic packing or exhaustive small-instance proofs.",
          "github.com/faustbrian/go-knapsack/verify": "Use to validate supplied plans independently from solver placement predicates.",
          "github.com/faustbrian/go-knapsack/visualize": "Use to render deterministic human-readable views of canonical plans."
        },
